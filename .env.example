# Canonical URL for metadata, Open Graph, and JSON-LD (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.vividin2wrio.com

# Optional: shows “Book a call” in the contact band
NEXT_PUBLIC_CALENDLY_URL=

# Optional: server-side enquiry email via https://resend.com
# When unset, the form opens the visitor’s mail client with a pre-filled message.
RESEND_API_KEY=
# Example while testing: Vivid <onboarding@resend.dev> (Resend docs)
RESEND_FROM=
CONTACT_EMAIL_TO=info@vividin2erio.com

# Optional: silent looping MP4/WebM for first hero slide (HTTPS URL). Omit to use image carousel only.
NEXT_PUBLIC_HERO_VIDEO_URL=
